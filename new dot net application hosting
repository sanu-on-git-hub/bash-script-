chmod 0644 "$NGINX_CONF"

log_event "ALL" "Nginx Configuration Creation" "SUCCESS" \
    "$NGINX_CONF"

# ==========================================================
# VALIDATE NGINX
# ==========================================================

if nginx -t; then

    log_event "ALL" "Nginx Configuration Validation" "SUCCESS" \
        "nginx -t passed"

else

    log_event "ALL" "Nginx Configuration Validation" "FAILURE" \
        "nginx -t failed"

    exit 1

fi

# ==========================================================
# SYSTEMD RELOAD
# ==========================================================

if systemctl daemon-reload; then

    log_event "ALL" "Systemd Daemon Reload" "SUCCESS" \
        "Systemd configuration reloaded"

else

    log_event "ALL" "Systemd Daemon Reload" "FAILURE" \
        "systemctl daemon-reload failed"

    exit 1

fi

# ==========================================================
# ENABLE AND START EACH INSTANCE
# ==========================================================

for SERVICE in "${SERVICES[@]}"; do

    if systemctl enable "$SERVICE" &&
       systemctl start "$SERVICE"; then

        log_event "$SERVICE" "Service Startup" "SUCCESS" \
            "Service enabled and start requested"

    else

        log_event "$SERVICE" "Service Startup" "FAILURE" \
            "Unable to enable or start service"

        journalctl -u "$SERVICE" -n 30 --no-pager || true

        exit 1

    fi

    if systemctl is-active --quiet "$SERVICE"; then

        log_event "$SERVICE" "Service Status" "SUCCESS" \
            "systemd reports active"

    else

        log_event "$SERVICE" "Service Status" "FAILURE" \
            "Service is not active"

        exit 1

    fi

    SOCKET="/run/${SERVICE}/${SERVICE}.sock"
    SOCKET_OK=0

    for ((attempt=1; attempt<=20; attempt++)); do

        if [ -S "$SOCKET" ]; then
            SOCKET_OK=1
            break
        fi

        sleep 2

    done

    if [ "$SOCKET_OK" -eq 1 ]; then

        log_event "$SERVICE" "Socket Verification" "SUCCESS" \
            "$SOCKET"

    else

        log_event "$SERVICE" "Socket Verification" "FAILURE" \
            "Socket not created: $SOCKET"

        journalctl -u "$SERVICE" -n 50 --no-pager || true

        exit 1

    fi

done

# ==========================================================
# RELOAD NGINX
# ==========================================================

if systemctl reload nginx; then

    log_event "ALL" "Nginx Reload" "SUCCESS" \
        "Nginx reloaded with new application configuration"

else

    log_event "ALL" "Nginx Reload" "FAILURE" \
        "Nginx reload failed"

    exit 1

fi

# ==========================================================
# HTTPS HEALTH CHECK
# ==========================================================

HEALTH_URL="https://${DOMAIN}:${PORT}/"

HTTP_CODE="000"
HEALTH_OK=0
CURL_ERROR=""
CURL_ERROR_FILE="/tmp/healthcheck-curl-error-${BUILD_NUMBER}.txt"

log_event "ALL" "HTTPS Health Check" "INFO" \
    "Starting IP-based HTTPS health check: $HEALTH_URL"

for ((attempt=1; attempt<=12; attempt++)); do

    HTTP_CODE="000"
    CURL_ERROR=""

    HTTP_CODE=$(curl \
        --silent \
        --show-error \
        --output /dev/null \
        --write-out '%{http_code}' \
        --connect-timeout 10 \
        --max-time 30 \
        --connect-to "${DOMAIN}:${PORT}:127.0.0.1:${PORT}" \
        "$HEALTH_URL" \
        2>"$CURL_ERROR_FILE" || true)

    CURL_ERROR=$(cat "$CURL_ERROR_FILE" 2>/dev/null || true)

    if [[ "$HTTP_CODE" =~ ^[23][0-9][0-9]$ ]]; then

        HEALTH_OK=1

        log_event "ALL" "HTTPS Health Check" "SUCCESS" \
            "IP URL: $HEALTH_URL; HTTP: $HTTP_CODE; TLS verification enabled"

        break

    fi

    log_event "ALL" "HTTPS Health Check Attempt ${attempt}" "WARNING" \
        "Attempt: ${attempt}/12; HTTP: ${HTTP_CODE}; Error: ${CURL_ERROR:-none}"

    sleep 5

done

rm -f "$CURL_ERROR_FILE"

if [ "$HEALTH_OK" -ne 1 ]; then

    log_event "ALL" "HTTPS Health Check" "FAILURE" \
        "IP-based HTTPS health check failed; HTTP: ${HTTP_CODE}; Error: ${CURL_ERROR:-none}"

    exit 1

fi
# ==========================================================
# FINAL SERVICE INFORMATION
# ==========================================================

for SERVICE in "${SERVICES[@]}"; do

    log_event "$SERVICE" "Final Service Verification" "SUCCESS" \
        "Service active and Unix socket verified"

done

log_event "ALL" "Deployment Completed" "SUCCESS" \
    "Application hosting successfully configured"

echo "Remote deployment completed."
